<?xml version="1.0"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>es.gobcan.istac.edatos-srm-visualizer</groupId>
        <artifactId>edatos-srm-visualizer</artifactId>
        <version>1.12.0</version>
    </parent>

    <artifactId>edatos-srm-visualizer-web</artifactId>
    <packaging>war</packaging>
    <name>edatos-srm-visualizer :: WEB</name>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <start-class>es.gobcan.istac.edatos.visualizer.Application</start-class>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <exclusions>
                <exclusion>
                    <artifactId>spring-boot-starter-tomcat</artifactId>
                    <groupId>org.springframework.boot</groupId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>es.gobcan.istac.edatos-srm-visualizer</groupId>
            <artifactId>edatos-srm-visualizer-js</artifactId>
        </dependency>
        <dependency>
            <groupId>es.gobcan.istac.edatos-srm-visualizer</groupId>
            <artifactId>edatos-srm-visualizer-rest</artifactId>
            <exclusions>
                <exclusion>
                    <artifactId>spring-boot-starter-tomcat</artifactId>
                    <groupId>org.springframework.boot</groupId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- TEST -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>${parent.artifactId}</finalName>
        <defaultGoal>spring-boot:run</defaultGoal>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>es.gobcan.istac.edatos.visualizer.Application</mainClass>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <version>3.3.1</version>
                <configuration>
                    <failOnMissingWebXml>false</failOnMissingWebXml>
                </configuration>
            </plugin>
            <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <version>1.3.1</version>
                    <dependencies>
                        <dependency>
                            <groupId>com.arte.maven.enforcer</groupId>
                            <artifactId>arte-enforcer-rules</artifactId>
                            <version>1.0.0</version>
                        </dependency>
                    </dependencies>
                    <executions>
                        <execution>
                            <id>enforce</id>
                            <configuration>
                                <rules>
                                    <CustomizedDependecyConvergence implementation="com.arte.libs.maven.arte.enforcer.rules.rule.CustomizedDependecyConvergence">
                                        <dependencies>
                                            <dependency>org.siemac.metamac</dependency>
                                            <dependency>com.arte.statistic</dependency>
                                            <dependency>com.arte.libs</dependency>
                                        </dependencies>
                                        <shouldfail>true</shouldfail>
                                        <checkConvergenceOnMayorVersions>false</checkConvergenceOnMayorVersions>
                                    </CustomizedDependecyConvergence>
                                </rules>
                            </configuration>
                            <goals>
                                <goal>enforce</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>dev</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <properties>
                <!-- log configuration -->
                <logback.loglevel>DEBUG</logback.loglevel>
            </properties>
        </profile>
        <profile>
            <id>env</id>
            <properties>
                <!-- log configuration -->
                <logback.loglevel>INFO</logback.loglevel>
                <spring.profiles.active>env</spring.profiles.active>
            </properties>
            <build>
                <resources>
                    <resource>
                        <directory>${basedir}/src/main/resources</directory>
                        <includes>
                            <include>*</include>
                        </includes>
                    </resource>
                    <resource>
                        <directory>../edatos-srm-visualizer-rest/target/</directory>
                        <targetPath>${build.directory}/${build.finalName}/WEB-INF/classes/config/</targetPath>
                        <includes>
                            <include>*.yml</include>
                        </includes>
                    </resource>
                </resources>
            </build>
        </profile>
    </profiles>
</project>
