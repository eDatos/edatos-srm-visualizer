<?xml version="1.0"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>es.gobcan.istac.edatos-srm-visualizer</groupId>
		<artifactId>edatos-srm-visualizer</artifactId>
		<version>0.0.1-SNAPSHOT</version>
	</parent>

	<artifactId>edatos-srm-visualizer-web</artifactId>
	<packaging>war</packaging>
	<name>edatos-srm-visualizer :: WEB</name>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<start-class>es.gobcan.istac.edatos.visualizer.rest.Application</start-class>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		<dependency>
			<groupId>es.gobcan.istac.edatos-srm-visualizer</groupId>
			<artifactId>edatos-srm-visualizer-js</artifactId>
		</dependency>
		<dependency>
			<groupId>es.gobcan.istac.edatos-srm-visualizer</groupId>
			<artifactId>edatos-srm-visualizer-rest</artifactId>
		</dependency>

		<!-- TEST -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<defaultGoal>spring-boot:run</defaultGoal>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<mainClass>es.gobcan.istac.edatos.visualizer.rest.Application</mainClass>
				</configuration>
			</plugin>
		</plugins>
	</build>
	<profiles>
		<profile>
			<id>dev</id>
			<activation>
				<activeByDefault>true</activeByDefault>
			</activation>
			<properties>
				<!-- log configuration -->
				<logback.loglevel>DEBUG</logback.loglevel>
			</properties>
		</profile>
		<profile>
			<id>env</id>
			<properties>
				<!-- log configuration -->
				<logback.loglevel>INFO</logback.loglevel>
			</properties>
		<!--
                    <dependencies>
                        <dependency>
                            <groupId>es.gobcan.istac.edatos-srm-visualizer</groupId>
                            <artifactId>edatos-srm-visualizer-js</artifactId>
                        </dependency>
                    </dependencies> -->
                </profile>
	</profiles>
</project>
