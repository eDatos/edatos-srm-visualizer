<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <!-- https://mvnrepository.com/artifact/org.springframework.boot/spring-boot-starter-parent -->
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.1.18.RELEASE</version>
    </parent>

    <groupId>es.gobcan.istac.edatos-srm-visualizer</groupId>
    <artifactId>edatos-srm-visualizer</artifactId>
    <version>1.10.2-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>eDatos SRM Visualizer</name>

    <scm>
        <connection>scm:git:https://git.arte-consultores.com/istac/edatos-srm-visualizer/</connection>
        <developerConnection>scm:git:https://git.arte-consultores.com/istac/edatos-srm-visualizer/</developerConnection>
        <tag>HEAD</tag>
        <url>https://git.arte-consultores.com/istac/edatos-srm-visualizer</url>
    </scm>
    <issueManagement>
        <system>Jira</system>
        <url>http://jira.arte-consultores.com/browse/EDATOS</url>
    </issueManagement>
    <distributionManagement>
        <repository>
            <id>arte-repository</id>
            <name>Arte Repository - RELEASE</name>
            <url>http://repository.arte-consultores.com/content/repositories/releases</url>
        </repository>
        <snapshotRepository>
            <id>arte-repository</id>
            <name>Arte Repository - SNAPSHOT</name>
            <url>http://repository.arte-consultores.com/content/repositories/snapshots</url>
        </snapshotRepository>
    </distributionManagement>

    <properties>
        <springframework-boot.version>2.1.18.RELEASE</springframework-boot.version>
        <tomcat.version>8.5.85</tomcat.version>
        <frontend-maven-plugin.version>1.4</frontend-maven-plugin.version>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
        <jee.servlet.version>3.1.0</jee.servlet.version>
        <java.version>1.8</java.version>
        <postgresql.version>42.3.1</postgresql.version>
        <assertj.version>3.6.2</assertj.version>
        <maven.build.timestamp.format>yyyyMMdd-HHmm</maven.build.timestamp.format>

        <metamac-srm-rest-external-api.version>3.0.0</metamac-srm-rest-external-api.version>
        <edatos-core-common.version>1.9.1</edatos-core-common.version>

    </properties>




    <build>
        <defaultGoal>spring-boot:run</defaultGoal>
        <pluginManagement>
            <plugins>
                <plugin>
                    <artifactId>maven-release-plugin</artifactId>
                    <version>2.5.3</version>
                    <configuration>
                        <useReleaseProfile>false</useReleaseProfile>
                        <tagNameFormat>${maven.build.timestamp}-v@{project.version}</tagNameFormat>
                    </configuration>
                </plugin>

            </plugins>
        </pluginManagement>
    </build>
    <profiles>
        <profile>
            <id>dev</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <modules>
                <module>edatos-srm-visualizer-js</module>
                <module>edatos-srm-visualizer-core</module>
                <module>edatos-srm-visualizer-rest</module>
                <module>edatos-srm-visualizer-web</module>

            </modules>
        </profile>

        <profile>
            <id>env</id>

            <modules>
                <module>edatos-srm-visualizer-js</module>
                <module>edatos-srm-visualizer-core</module>
                <module>edatos-srm-visualizer-rest</module>
                <module>edatos-srm-visualizer-web</module>

            </modules>
        </profile>
    </profiles>

    <dependencyManagement>
        <dependencies>

            <!-- eDatos External Users -->
            <dependency>
                <groupId>es.gobcan.istac.edatos-srm-visualizer</groupId>
                <artifactId>edatos-srm-visualizer-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>es.gobcan.istac.edatos-srm-visualizer</groupId>
                <artifactId>edatos-srm-visualizer-rest</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>es.gobcan.istac.edatos-srm-visualizer</groupId>
                <artifactId>edatos-srm-visualizer-js</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>es.gobcan.istac.edatos-srm-visualizer</groupId>
                <artifactId>edatos-srm-visualizer-web</artifactId>
                <version>${project.version}</version>
            </dependency>


            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
                <scope>provided</scope>
            </dependency>


            <dependency>
                <groupId>org.siemac.metamac</groupId>
                <artifactId>edatos-core-common</artifactId>
                <version>${edatos-core-common.version}</version>
            </dependency>

            <!-- Spring -->

            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-starter-log4j2</artifactId>
                <version>${springframework-boot.version}</version>
            </dependency>

            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-starter-web</artifactId>
                <version>${springframework-boot.version}</version>
                <exclusions>
                    <exclusion>
                        <groupId>org.springframework.boot</groupId>
                        <artifactId>spring-boot-starter-logging</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>


             <!-- Servlet -->
            <dependency>
                <groupId>javax.servlet</groupId>
                <artifactId>javax.servlet-api</artifactId>
                <version>${jee.servlet.version}</version>
                <scope>provided</scope>
            </dependency>

            <!-- Test -->
            <dependency>
                <groupId>org.assertj</groupId>
                <artifactId>assertj-core</artifactId>
                <version>${assertj.version}</version>
                <scope>test</scope>
            </dependency>

            <dependency>
                <groupId>org.awaitility</groupId>
                <artifactId>awaitility</artifactId>
                <version>${awaitility.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>es.gobcan.istac.edatos-srm-visualizer</groupId>
                <artifactId>edatos-srm-visualizer-core</artifactId>
                <version>${project.version}</version>
                <type>test-jar</type>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.siemac.metamac</groupId>
                <artifactId>edatos-core-common</artifactId>
                <type>test-jar</type>
                <version>${edatos-core-common.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-starter-test</artifactId>
                <version>${springframework-boot.version}</version>
                <scope>test</scope>
                <exclusions>
                    <exclusion>
                        <groupId>com.vaadin.external.google</groupId>
                        <artifactId>android-json</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>
            <dependency>
                <groupId>com.h2database</groupId>
                <artifactId>h2</artifactId>
                <version>${h2.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
