<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <!-- https://mvnrepository.com/artifact/org.springframework.boot/spring-boot-starter-parent -->
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.1.18.RELEASE</version>
    </parent>

    <groupId>es.gobcan.istac.edatos-srm-visualizer</groupId>
    <artifactId>edatos-srm-visualizer</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>eDatos SRM Visualizer</name>

    <scm>
        <connection>scm:git:http://git.arte-consultores.com/istac/edatos-srm-visualizer/</connection>
        <developerConnection>scm:git:http://git.arte-consultores.com/istac/edatos-srm-visualizer/</developerConnection>
        <tag>HEAD</tag>
        <url>http://git.arte-consultores.com/istac/edatos-srm-visualizer</url>
    </scm>
    <issueManagement>
        <system>Jira</system>
        <url>http://jira.arte-consultores.com/browse/EDATOS</url>
    </issueManagement>
    <distributionManagement>
        <repository>
            <id>arte-repository</id>
            <name>Arte Repository - RELEASE</name>
            <url>http://repository.arte-consultores.com/content/repositories/releases</url>
        </repository>
        <snapshotRepository>
            <id>arte-repository</id>
            <name>Arte Repository - SNAPSHOT</name>
            <url>http://repository.arte-consultores.com/content/repositories/snapshots</url>
        </snapshotRepository>
    </distributionManagement>

    <properties>
        <springframework-boot.version>2.1.18.RELEASE</springframework-boot.version>
        <tomcat.version>8.5.85</tomcat.version>
        <frontend-maven-plugin.version>1.4</frontend-maven-plugin.version>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
        <jee.servlet.version>3.1.0</jee.servlet.version>
        <java.version>1.8</java.version>
        <postgresql.version>9.4.1212</postgresql.version>

        <metamac-srm-rest-internal-api.version>2.6.1-SNAPSHOT</metamac-srm-rest-internal-api.version>
        <metamac-srm-rest-external-api.version>2.2.0</metamac-srm-rest-external-api.version>
        <edatos-external-user.version>1.0.1-SNAPSHOT</edatos-external-user.version>
        <edatos-core-common.version>1.0.2-SNAPSHOT</edatos-core-common.version>
        <edatos-rest-common.version>1.0.0</edatos-rest-common.version>
    </properties>




    <build>
        <defaultGoal>spring-boot:run</defaultGoal>
        <pluginManagement>
            <plugins>
                <plugin>
                    <artifactId>maven-release-plugin</artifactId>
                    <version>2.5.3</version>
                    <configuration>
                        <useReleaseProfile>false</useReleaseProfile>
                        <tagNameFormat>${maven.build.timestamp}-v@{project.version}</tagNameFormat>
                    </configuration>
                </plugin>

            </plugins>
        </pluginManagement>
    </build>
    <profiles>
        <profile>
            <id>dev</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <modules>
                <module>edatos-srm-visualizer-js</module>
                <module>edatos-srm-visualizer-core</module>
                <module>edatos-srm-visualizer-rest</module>
                <module>edatos-srm-visualizer-web</module>

            </modules>
        </profile>

        <profile>
            <id>env</id>

            <modules>
                <module>edatos-srm-visualizer-js</module>
                <module>edatos-srm-visualizer-core</module>
                <module>edatos-srm-visualizer-rest-common</module>
                <module>edatos-srm-visualizer-rest</module>
                <module>edatos-srm-visualizer-web</module>

            </modules>
        </profile>
    </profiles>

